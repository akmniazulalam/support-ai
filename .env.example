# Local Docker development only. Copy to .env before running Docker Compose.
POSTGRES_USER=supportai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supportai

JWT_ACCESS_SECRET=replace-with-a-local-access-secret
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Leave empty to run non-AI flows locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
